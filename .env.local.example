# ── Rashi6 admin (/admin) ───────────────────────────────────────
# Copy this file to ".env.local" for local dev, and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# Required — the password for the /admin page.
ADMIN_PASSWORD=Boom50505

# ── GitHub auto-commit (optional locally, required on Vercel) ────
# When these are set, saving in /admin commits the updated locale
# files to your repo, which triggers a Vercel redeploy.
# When they are NOT set, /admin writes the JSON files directly
# (works in `next dev`).
#
# Create a GitHub fine-grained Personal Access Token scoped to this
# repo with "Contents: Read and write" permission.
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo-name
GITHUB_BRANCH=main
